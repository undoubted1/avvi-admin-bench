    "temperature_zero": {
      "default": true,
      "title": "Temperature Zero",
      "type": "boolean"
    },
    "turns": {
      "default": 0,
      "minimum": 0,
      "title": "Turns",
      "type": "integer"
    },
    "usage": {
      "$ref": "#/$defs/Usage"
    }
