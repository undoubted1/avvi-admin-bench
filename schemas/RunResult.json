    "cost": {
      "default": 0.0,
      "minimum": 0,
      "title": "Cost",
      "type": "number"
    },
    "duration_s": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration S"
